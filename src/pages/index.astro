---
const reasons = [
  {
    image: '/images/safety.jpg',
    stat: '54%',
    title: 'More collisions',
    text: 'Ontario’s own analysis estimates that removing protected lanes could increase collisions by more than 54%.',
    source: 'Ontario internal documents, reported by The Trillium',
    sourceUrl: 'https://www.thetrillium.ca/news/municipalities-transit-and-infrastructure/removing-bike-lanes-worsen-gridlock-increase-collisions-government-documents-10360308',
  },
  {
    image: '/images/cost-construction.jpg',
    stat: '$48M+',
    title: 'Millions wasted',
    text: 'Toronto estimates it will cost more than $48 million to remove lanes that cost $27 million to build. That is only for three of the six corridors.',
    source: 'City Manager’s report to Toronto City Council',
    sourceUrl: 'https://www.toronto.ca/legdocs/mmis/2024/cc/bgrd/backgroundfile-250545.pdf',
  },
  {
    image: '/images/business.jpg',
    stat: '90%',
    title: 'Better for businesses',
    text: 'A peer-reviewed Bloor study found no negative economic impact. Ninety per cent of customers arrived on foot, by bike, or by transit.',
    source: 'Bloor Annex and Korea Town Economic Impact Study',
    sourceUrl: 'https://www.tcat.ca/wp-content/uploads/2017/12/Bloor-Economic-Impact-Study-Full-Report-2019-09-03.pdf',
  },
];

const news = [
  { outlet: 'The Guardian', title: 'Removing Toronto bike lanes will make traffic worse, official document shows', url: 'https://www.theguardian.com/world/2024/nov/22/toronto-bike-lane-removal-congestion' },
  { outlet: 'Global News', title: 'Ford government passes law to remove Ontario bike lanes', url: 'https://globalnews.ca/news/10887272/ontario-bike-lane-removal-law-passes/' },
  { outlet: 'The Green Line', title: 'Toronto bike lane removals: what they mean for road safety', url: 'https://thegreenline.to/issue/toronto-bike-lane-removals-road-safety/' },
  { outlet: 'The Trillium', title: 'Government documents warn removals could worsen gridlock and collisions', url: 'https://www.thetrillium.ca/news/municipalities-transit-and-infrastructure/removing-bike-lanes-worsen-gridlock-increase-collisions-government-documents-10360308' },
  { outlet: 'CycleTO', title: 'What happens next with Toronto’s bike lanes?', url: 'https://www.cycleto.ca/what_happens_next_with_torontos_bike_lanes' },
];

const gallery = [
  ['cyclist-count.jpg', 'Cyclist count sign on a Toronto street'],
  ['priorities-poster.jpg', 'Ontario priorities campaign poster'],
  ['pole-poster.jpg', 'Protect Toronto bike lanes poster on a pole'],
  ['storefront-poster.jpg', 'Campaign poster in a storefront'],
  ['bloor-aerial.jpg', 'Aerial view of the Bloor bike lane'],
  ['chow-bike.jpg', 'Mayor Olivia Chow with a bicycle'],
  ['ford-bike.jpg', 'Doug Ford wearing a bicycle helmet'],
  ['bloor-counts.jpg', 'Bloor Street cycling count chart'],
  ['car-sticker.jpg', 'Save Lanes sticker on a car window'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Save Toronto's protected bike lanes." />
    <link rel="icon" type="image/svg+xml" href="/images/bike-logo.svg" />
    <title>Save Lanes, Save Lives</title>
    <script is:inline>
      (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[])
      .push(arguments);},l=d.createElement(e),l.async=1,l.src=u,
      n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
      (window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
      ml('account', '2639699');
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Save Lanes home">
        <svg class="brand-mark" viewBox="0 0 200 200" role="img" aria-label="Save Lanes bicycle logo">
          <defs>
            <clipPath id="brand-mark-clip"><circle cx="100" cy="100" r="89" /></clipPath>
          </defs>
          <circle cx="100" cy="100" r="94" fill="#08a82a" stroke="#fff" stroke-width="9" />
          <g class="brand-bike" clip-path="url(#brand-mark-clip)" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="8">
            <circle cx="62" cy="135" r="26" />
            <circle cx="140" cy="135" r="26" />
            <path d="M62 135 89 84l18 51H62l37-51h23l18 51M89 84h-17M83 78h21M122 78h18l5 12" />
          </g>
        </svg>
      </a>
      <nav aria-label="Main navigation">
        <a href="#why">Why it matters</a>
        <a href="/about">About</a>
        <a href="#sign-up">Get a sign</a>
        <a href="#take-action">Take action</a>
        <a class="nav-donate" href="https://www.cycleto.ca/donate" target="_blank" rel="noreferrer">Donate</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <img class="hero-image" src="/images/hero-bike-lane.jpg" alt="People cycling in a protected Toronto bike lane" />
        <div class="hero-shade"></div>
        <div class="hero-content">
          <p class="eyebrow">Ontario is removing Toronto’s protected bike lanes.</p>
          <h1 id="hero-title">Save lanes.<br />Save lives.</h1>
          <p class="hero-copy">It will make our streets less safe, cost millions, and will not fix gridlock.</p>
          <a class="button" href="#sign-up">Get a sticker, poster or yard sign</a>
        </div>
      </section>

      <section class="intro" id="why" aria-labelledby="intro-title">
        <h2 id="intro-title">Ontario plans to tear out 19 kilometres of Toronto’s protected bike lanes.</h2>
        <p>It is an expensive, disruptive plan to undo infrastructure that is already helping people move safely. Government experts warned the province that removal would increase collisions and provide little, if any, lasting congestion relief.</p>
      </section>

      <section class="common-ground" aria-labelledby="common-ground-title">
        <p class="section-label">Common ground</p>
        <h2 id="common-ground-title">This is not cars versus bikes.</h2>
        <p>Drivers, cyclists, pedestrians, transit riders, and local businesses all want the same things: safer streets, less congestion, and a city that uses public money wisely. Protected lanes give more people a safe way to make short trips without adding another car to crowded roads. Restoring a few car lanes downtown will not solve congestion because it encourages more driving and any short-term gain disappears. Toronto should be able to make evidence-based street decisions for its own communities.</p>
        <a class="inline-source" href="https://www.cycleto.ca/cycle_toronto_v_ontario" target="_blank" rel="noreferrer">Read the evidence behind this argument at CycleTO ↗</a>
      </section>

      <section class="reasons" aria-labelledby="reasons-title">
        <div class="section-heading">
          <h2 id="reasons-title">The facts don’t support removal.</h2>
        </div>
        <div class="reason-grid">
          {reasons.map((reason) => (
            <article class="reason-card">
              <img src={reason.image} alt="" loading="lazy" />
              <div class="reason-copy">
                <p class="stat">{reason.stat}</p>
                <h3>{reason.title}</h3>
                <p>{reason.text}</p>
                <a class="source" href={reason.sourceUrl} target="_blank" rel="noreferrer">Source: {reason.source} ↗</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="data" aria-labelledby="data-title">
        <div class="section-heading"><p class="section-label">The numbers</p><h2 id="data-title">More cost. More risk. No congestion cure.</h2></div>
        <div class="chart-grid">
          <article class="chart-card">
            <p class="chart-label">Estimated collisions after removal</p>
            <div class="bar-row"><span>Today</span><i style="--bar:65%"></i><b>100</b></div>
            <div class="bar-row danger"><span>After removal</span><i style="--bar:100%"></i><b>154</b></div>
            <p>Ontario’s analysis estimated a more than 54% increase in collisions.</p>
            <a class="source" href="https://www.thetrillium.ca/news/municipalities-transit-and-infrastructure/removing-bike-lanes-worsen-gridlock-increase-collisions-government-documents-10360308" target="_blank" rel="noreferrer">Source: The Trillium ↗</a>
          </article>
          <article class="chart-card">
            <p class="chart-label">Public money</p>
            <div class="money-row"><span>Built</span><strong>$27M</strong><i style="--bar:56%"></i></div>
            <div class="money-row danger"><span>To remove</span><strong>$48M+</strong><i style="--bar:100%"></i></div>
            <p>The city’s estimate covers only three of the six corridors now at risk.</p>
            <a class="source" href="https://www.toronto.ca/legdocs/mmis/2024/cc/bgrd/backgroundfile-250545.pdf" target="_blank" rel="noreferrer">Source: City Manager’s report ↗</a>
          </article>
        </div>
      </section>

      <section class="quote-section chow-quote">
        <img src="/images/gallery/chow-bike.jpg" alt="Mayor Olivia Chow with her bicycle" loading="lazy" />
        <blockquote>
          <p>“We provided drawings, we provided studies, we provided everything they want so that we could put in the bike lanes and bring back a car lane.”</p>
          <footer>Mayor Olivia Chow, on the City’s proposed Bloor compromise</footer>
          <a href="https://www.cycleto.ca/what_happens_next_with_torontos_bike_lanes" target="_blank" rel="noreferrer">Read the CycleTO update ↗</a>
        </blockquote>
      </section>

      <section class="map-section" aria-labelledby="map-title">
        <div><p class="section-label">At risk</p><h2 id="map-title">The proposed removals span three key Toronto corridors.</h2><p>The province’s current RFP covers Bloor, Yonge, and University/Avenue Road. The map is a route guide, not an engineering drawing.</p><a class="inline-source" href="https://www.cycleto.ca/what_happens_next_with_torontos_bike_lanes" target="_blank" rel="noreferrer">CycleTO’s current corridor details ↗</a></div>
        <svg class="route-map" viewBox="0 0 640 430" role="img" aria-label="Schematic map of bike lane removal corridors on Bloor, Yonge, and University">
          <rect width="640" height="430" rx="10" fill="#eef3ea" />
          <path d="M55 250H580" stroke="#101410" stroke-width="24" opacity=".12" /><path d="M55 250H580" stroke="#08a82a" stroke-width="12" stroke-linecap="round" />
          <path d="M420 45V390" stroke="#101410" stroke-width="24" opacity=".12" /><path d="M420 45V390" stroke="#08a82a" stroke-width="12" stroke-linecap="round" />
          <path d="M260 65C280 155 305 180 355 230" stroke="#101410" stroke-width="24" fill="none" opacity=".12" /><path d="M260 65C280 155 305 180 355 230" stroke="#08a82a" stroke-width="12" fill="none" stroke-linecap="round" />
          <g fill="#101410" font-family="Inter, sans-serif" font-weight="800"><text x="65" y="230">BLOOR</text><text x="435" y="95">YONGE</text><text x="205" y="58">UNIVERSITY /</text><text x="205" y="79">AVENUE ROAD</text></g>
          <g fill="#101410" font-family="Inter, sans-serif" font-size="14"><text x="65" y="278">Royal York → Castle Frank</text><text x="438" y="118">Hayden → Millwood</text><text x="185" y="103">Davenport → Heenan</text></g>
          <text x="55" y="390" fill="#416142" font-family="Inter, sans-serif" font-size="15" font-weight="700">19 km proposed for removal or reconfiguration</text>
        </svg>
      </section>

      <section class="quote-section ford-quote">
        <img src="/images/gallery/ford-bike.jpg" alt="Doug Ford wearing a bicycle helmet" loading="lazy" />
        <blockquote>
          <p>“I want to work collaboratively with the Mayor … hopefully we can find alternatives.”</p>
          <footer>Premier Doug Ford, June 2025</footer>
          <a href="https://www.cycleto.ca/what_happens_next_with_torontos_bike_lanes" target="_blank" rel="noreferrer">Read the context at CycleTO ↗</a>
        </blockquote>
      </section>

      <section class="news" aria-labelledby="news-title">
        <p class="section-label">Read more</p><h2 id="news-title">Coverage worth reading.</h2>
        <div class="news-links">{news.map((item) => <a href={item.url} target="_blank" rel="noreferrer"><span>{item.outlet}</span>{item.title}<b>↗</b></a>)}</div>
      </section>

      <section class="signup" id="sign-up" aria-labelledby="signup-title">
        <div>
          <p class="section-label">Help spread the word</p>
          <h2 id="signup-title">Get a campaign sign.</h2>
          <p>Sign up for a sticker, poster, or yard sign. We’ll email you with availability and pickup details.</p>
        </div>
        <div class="signup-form">
          <div class="ml-embedded" data-form="ytCH80"></div>
        </div>
      </section>

      <section class="action" id="take-action" aria-labelledby="action-title">
        <div>
          <p class="section-label">Make your voice heard</p>
          <h2 id="action-title">Tell Ontario to stop removing Toronto’s bike lanes.</h2>
          <p>Join the Defend Bloor campaign and tell your MPP that safer streets should not be dismantled.</p>
        </div>
        <div class="action-links">
          <a class="button" href="https://www.cycleto.ca/defendbloor" target="_blank" rel="noreferrer">Sign the petition</a>
          <a class="text-link" href="https://www.ola.org/en/office-assembly/whats-happening/how-contact-your-mpp" target="_blank" rel="noreferrer">Find your MPP <span aria-hidden="true">→</span></a>
          <p class="partner-note">The petition link opens CycleTO’s Defend Bloor campaign.</p>
        </div>
      </section>

      <section class="gallery" aria-labelledby="gallery-title">
        <div class="gallery-heading"><p class="section-label">Out in the city</p><h2 id="gallery-title">This movement is growing.</h2></div>
        <div class="gallery-track">
          {gallery.map(([image, alt]) => <img src={`/images/gallery/${image}`} alt={alt} loading="lazy" />)}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>Save Lanes, Save Lives<br /><span>Volunteer-run, independent, and not for profit.</span></p>
      <p><a href="https://www.cycleto.ca/cycle_toronto_v_ontario" target="_blank" rel="noreferrer">Read CycleTO’s research and legal case ↗</a></p>
      <p><a href="https://www.cycleto.ca" target="_blank" rel="noreferrer">CycleTO ↗</a><a href="https://www.reddit.com/r/torontobiking/" target="_blank" rel="noreferrer">r/torontobiking ↗</a><a href="https://thebikinglawyer.ca" target="_blank" rel="noreferrer">The Biking Lawyer ↗</a></p>
    </footer>
  </body>
</html>

<style>
  :root { --green: #08a82a; --ink: #101410; --cream: #f6f4ee; --line: #dde1d9; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; color: var(--ink); background: var(--cream); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  a { color: inherit; }
  .site-header { height: 86px; padding: 10px clamp(24px, 6vw, 94px); display: flex; align-items: center; justify-content: space-between; background: #fff; }
  .brand { display: inline-flex; align-items: center; }
  .brand-mark { width: 66px; height: 66px; overflow: visible; }
  .brand-bike { animation: bike-arrives .9s cubic-bezier(.2,.8,.2,1) .08s both; transform-box: view-box; transform-origin: center; }
  @keyframes bike-arrives { from { transform: translateX(-140px); } 72% { transform: translateX(7px); } to { transform: translateX(0); } }
  nav { display: flex; align-items: center; gap: 26px; font-weight: 700; }
  nav a, .text-link { text-decoration: none; }
  nav a:hover, .text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .nav-donate { padding: 11px 17px; border-radius: 4px; background: #ffe26b; text-decoration: none; }
  .nav-donate:hover { background: var(--green); color: #fff; text-decoration: none; }
  .hero { position: relative; min-height: min(680px, calc(100vh - 86px)); display: grid; place-items: center; overflow: hidden; isolation: isolate; }
  .hero-image, .hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-image { object-fit: cover; }
  .hero-shade { background: linear-gradient(90deg, rgba(0, 0, 0, .76) 0%, rgba(0, 0, 0, .42) 52%, rgba(0, 0, 0, .16) 100%); z-index: 1; }
  .hero-content { width: min(1100px, 88vw); position: relative; z-index: 2; color: #fff; }
  .eyebrow, .section-label { margin: 0 0 12px; font-size: .78rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { max-width: 780px; margin-bottom: 20px; font-size: clamp(3.5rem, 8vw, 7.2rem); line-height: .91; letter-spacing: -.075em; }
  .hero-copy { max-width: 580px; margin-bottom: 32px; font-size: clamp(1.06rem, 2vw, 1.35rem); line-height: 1.45; }
  .button { display: inline-block; padding: 15px 24px; border-radius: 4px; background: #ffe26b; color: #101410; font-weight: 850; text-decoration: none; }
  .button:hover { background: #fff; }
  .intro, .reasons, .signup, .action { padding: clamp(70px, 10vw, 140px) clamp(24px, 7vw, 112px); }
  .intro { max-width: 1050px; }
  h2 { max-width: 850px; margin-bottom: 22px; font-size: clamp(2.2rem, 4.5vw, 4.4rem); line-height: .98; letter-spacing: -.055em; }
  .intro > p:last-child { max-width: 760px; margin: 0; font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.55; }
  .common-ground { padding: clamp(70px, 10vw, 125px) clamp(24px, 7vw, 112px); background: var(--ink); color: #fff; }
  .common-ground h2 { max-width: 720px; } .common-ground > p:not(.section-label) { max-width: 900px; margin-bottom: 26px; font-size: clamp(1.12rem, 2vw, 1.42rem); line-height: 1.55; }
  .inline-source { color: inherit; font-weight: 800; text-underline-offset: 4px; }
  .reasons { background: #fff; }
  .section-heading { margin-bottom: 42px; }
  .reason-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  .reason-card { background: var(--cream); }
  .reason-card > img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .reason-copy { padding: 24px; }
  .stat { margin-bottom: 8px; color: var(--green); font-size: 2.4rem; font-weight: 900; letter-spacing: -.06em; }
  h3 { margin-bottom: 10px; font-size: 1.55rem; letter-spacing: -.04em; }
  .reason-copy p:last-child { margin-bottom: 0; line-height: 1.48; }
  .source { display: inline-block; margin-top: 18px; color: #416142; font-size: .82rem; font-weight: 750; line-height: 1.35; }
  .data { padding: clamp(70px, 10vw, 130px) clamp(24px, 7vw, 112px); background: #e7f5e8; }
  .chart-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .chart-card { padding: 28px; background: #fff; } .chart-label { margin-bottom: 26px; font-size: .85rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .bar-row { display: grid; grid-template-columns: 108px 1fr 40px; gap: 12px; align-items: center; margin: 12px 0; font-weight: 800; } .bar-row i, .money-row i { display:block; height:18px; background: var(--green); width: var(--bar); } .bar-row.danger i, .money-row.danger i { background: #101410; }
  .money-row { display:grid; grid-template-columns: 86px 82px 1fr; gap: 12px; align-items:center; margin: 16px 0; font-weight:800; } .money-row strong { font-size:1.35rem; letter-spacing:-.04em; }
  .chart-card > p:not(.chart-label) { margin: 26px 0 0; line-height:1.45; }
  .quote-section { display:grid; grid-template-columns: minmax(260px, .75fr) minmax(0, 1.25fr); min-height: 490px; background:#fff; } .quote-section > img { width:100%; height:100%; min-height:360px; object-fit:cover; } .quote-section blockquote { margin:0; padding:clamp(42px,8vw,110px); align-self:center; } .quote-section blockquote p { margin-bottom:28px; font-size:clamp(2rem,4.4vw,4.7rem); font-weight:900; line-height:.98; letter-spacing:-.065em; } .quote-section blockquote footer { margin-bottom:24px; color:#416142; font-weight:800; } .quote-section blockquote a { font-weight:850; text-underline-offset:4px; }
  .ford-quote { background:#101410; color:#fff; } .ford-quote blockquote footer { color:#aee8af; }
  .map-section { display:grid; grid-template-columns: minmax(0,.8fr) minmax(320px,1.2fr); gap:clamp(36px,7vw,100px); align-items:center; padding:clamp(70px,10vw,130px) clamp(24px,7vw,112px); background:var(--cream); } .map-section > div > p:not(.section-label) { max-width:570px; margin-bottom:26px; font-size:1.1rem; line-height:1.5; } .route-map { width:100%; height:auto; }
  .news { padding:clamp(70px,10vw,130px) clamp(24px,7vw,112px); background:var(--green); color:#fff; } .news-links { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; } .news-links a { min-height:120px; display:grid; align-content:start; gap:8px; padding:20px; background:#fff; color:var(--ink); font-size:1.12rem; font-weight:850; text-decoration:none; } .news-links a:hover { background:#ffe26b; } .news-links span { color:#416142; font-size:.77rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; } .news-links b { color:var(--green); font-size:1.25rem; }
  .signup { display: grid; grid-template-columns: minmax(0, .9fr) minmax(330px, .7fr); gap: clamp(40px, 8vw, 120px); align-items: start; background: var(--cream); }
  .signup > div > p:last-child { max-width: 580px; margin-bottom: 0; font-size: 1.1rem; line-height: 1.5; }
  .signup-form { padding: 28px; background: #fff; border-top: 7px solid var(--green); }
  .action { display: flex; gap: 50px; align-items: end; justify-content: space-between; background: var(--green); color: #fff; }
  .action h2 { max-width: 700px; }
  .action > div:first-child > p:last-child { max-width: 630px; margin-bottom: 0; font-size: 1.1rem; line-height: 1.5; }
  .action-links { display: grid; gap: 18px; flex: 0 0 auto; }
  .text-link { font-weight: 800; }
  .partner-note { max-width: 250px; margin: 0; font-size: .78rem; line-height: 1.35; opacity: .8; }
  .gallery { padding:clamp(70px,10vw,120px) 0; overflow:hidden; background:#fff; } .gallery-heading { padding:0 clamp(24px,7vw,112px); } .gallery-track { display:flex; gap:16px; width:max-content; padding:0 16px; animation: gallery-roll 45s linear infinite; } .gallery-track:hover { animation-play-state:paused; } .gallery-track img { width:310px; height:240px; object-fit:cover; } @keyframes gallery-roll { from { transform:translateX(0); } to { transform:translateX(-25%); } }
  .site-footer { display: grid; grid-template-columns:1.2fr 1fr 1fr; gap: 28px; padding: 32px clamp(24px, 7vw, 112px); background: #101410; color: #fff; font-size: .85rem; }
