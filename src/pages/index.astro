---
const reasons = [
  {
    image: '/images/safety.jpg',
    label: 'Safety',
    title: 'Removal means more collisions',
    text: 'Ontario’s own analysis predicts a 54% increase in collisions if protected lanes are removed.',
    source: 'Ontario internal documents, reported by The Trillium',
    sourceUrl: 'https://www.thetrillium.ca/news/municipalities-transit-and-infrastructure/removing-bike-lanes-worsen-gridlock-increase-collisions-government-documents-10360308',
  },
  {
    image: '/images/cost-construction.jpg',
    label: 'Cost',
    title: 'Millions to tear out lanes that work',
    text: 'Toronto estimates $48M+ to remove lanes built for $27M. The estimate covers only three of the six corridors at risk.',
    source: 'City Manager’s report to Toronto City Council',
    sourceUrl: 'https://www.toronto.ca/legdocs/mmis/2024/cc/bgrd/backgroundfile-250545.pdf',
  },
  {
    image: '/images/business.jpg',
    label: 'Traffic',
    title: 'More people moving without cars',
    text: 'At Bloor rush hour, 1,849 people use the bike lane, compared with 1,741 motor vehicles next to it. Safe lanes give people an alternative to adding another car to the road.',
    source: 'Bloor rush-hour count, reported by TorontoToday',
    sourceUrl: 'https://www.torontotoday.ca/local/transportation-infrastructure/bikes-outnumber-cars-bloor-street-west-rush-hour-data-10855921',
  },
];

const news = [
  { outlet: 'Global News', title: 'City report puts the cost of removal at $48 million', url: 'https://globalnews.ca/news/10868485/toronto-bike-lane-removal-cost-congestion-blame/' },
  { outlet: 'Global News', title: 'Ford dismisses Toronto’s $48-million removal estimate', url: 'https://globalnews.ca/news/10877114/ontario-doug-ford-bike-lane-removal-cost-hogwash/' },
  { outlet: 'The Trillium', title: 'Government documents warn removal could worsen collisions and gridlock', url: 'https://www.thetrillium.ca/news/municipalities-transit-and-infrastructure/removing-bike-lanes-worsen-gridlock-increase-collisions-government-documents-10360308' },
  { outlet: 'TVO Today', title: 'Is there a right to bike lanes? Bill 212’s Charter challenge explained', url: 'https://www.tvo.org/article/is-there-a-right-to-bike-lanes-bill-212s-charter-challenge-explained' },
  { outlet: 'CycleTO', title: 'What happens next with Toronto’s bike lanes?', url: 'https://www.cycleto.ca/what_happens_next_with_torontos_bike_lanes' },
];

const gallery = [
  ['campaign-priorities.jpg', 'Save Lanes priorities poster on a Toronto street'],
  ['campaign-pole.jpg', 'Protect Toronto bike lanes poster on a street pole'],
  ['campaign-storefront.jpg', 'Save Lanes sticker on a Bloor Street storefront'],
  ['campaign-car-sticker.jpg', 'Save Lanes sticker on a car window'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Save Toronto's protected bike lanes." />
    <link rel="icon" type="image/png" href="/images/bike-logo.png" />
    <title>Save Lanes, Save Lives</title>
    <script is:inline>
      (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[])
      .push(arguments);},l=d.createElement(e),l.async=1,l.src=u,
      n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
      (window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
      ml('account', '2639699');
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Save Lanes home">
        <img class="brand-mark" src="/images/bike-logo.png" alt="" />
      </a>
      <nav aria-label="Main navigation">
        <a href="#why">Why it matters</a>
        <a href="/about">About</a>
        <a href="#sign-up">Get a sign</a>
        <a class="nav-petition" href="https://www.cycleto.ca/defendbloor" target="_blank" rel="noreferrer">Sign the CycleTO Petition</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <img class="hero-image" src="/images/hero-bike-lane.jpg" alt="People cycling in a protected Toronto bike lane" />
        <div class="hero-shade"></div>
        <div class="hero-content">
          <h1 id="hero-title">Save lanes,<br />Save lives.</h1>
          <p class="hero-copy">Ontario’s plan to remove Toronto’s protected bike lanes would make our streets less safe, waste public money, and fail to fix congestion</p>
          <div class="hero-actions">
            <a class="button" href="#sign-up">Get a sticker, poster or yard sign</a>
            <a class="hero-petition" href="https://www.cycleto.ca/defendbloor" target="_blank" rel="noreferrer">Sign the CycleTO Petition</a>
          </div>
        </div>
      </section>

      <section class="intro" id="why" aria-labelledby="intro-title">
        <h2 id="intro-title">Ontario plans to tear out 19 kilometres of Toronto’s protected bike lanes</h2>
        <p>It is an expensive and disruptive plan to undo infrastructure that is already helping people move safely</p>
      </section>

      <section class="reasons" aria-labelledby="reasons-title">
        <div class="section-heading">
          <h2 id="reasons-title">The facts don’t support removal</h2>
        </div>
        <div class="reason-grid">
          {reasons.map((reason) => (
            <article class="reason-card">
              <img src={reason.image} alt="" loading="lazy" />
              <div class="reason-copy">
                <p class="reason-label">{reason.label}</p>
                <h3>{reason.title}</h3>
                <p>{reason.text}</p>
                <a class="source" href={reason.sourceUrl} target="_blank" rel="noreferrer">Source: {reason.source} ↗</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="supporting-facts" aria-label="Local evidence">
        <article>
          <p class="proof-stat">No negative<br />economic impact</p>
          <h2>Protected lanes did not hurt local business</h2>
          <p>A peer-reviewed Bloor study, commissioned by the Bloor Annex and Korea Town BIAs, found no negative economic impact after the lane was installed.</p>
          <a class="source" href="https://www.tcat.ca/wp-content/uploads/2017/12/Bloor-Economic-Impact-Study-Full-Report-2019-09-03.pdf" target="_blank" rel="noreferrer">Source: Bloor economic impact study ↗</a>
        </article>
        <article>
          <p class="proof-stat">21–4</p>
          <h2>Toronto City Council opposed the removals</h2>
          <p>The province is overruling the council elected to decide how Toronto’s streets should work, despite a 21–4 vote against Bill 212.</p>
          <a class="source" href="https://www.cbc.ca/news/canada/toronto/toronto-bike-lane-removal-city-council-1.7383223" target="_blank" rel="noreferrer">Source: CBC News ↗</a>
        </article>
      </section>

      <section class="common-ground" aria-labelledby="common-ground-title">
        <div class="common-title">
          <h2 id="common-ground-title">Safer streets and less congestion are goals we all share</h2>
        </div>
        <div class="common-copy">
          <p>Drivers, cyclists, pedestrians, transit riders, and local businesses all need streets that work. Protected lanes make short trips safer without adding another car to already crowded roads.</p>
          <p class="common-callout">Toronto should be able to make evidence-based decisions about its own streets</p>
          <a class="inline-source" href="https://www.cycleto.ca/cycle_toronto_v_ontario" target="_blank" rel="noreferrer">Read CycleTO’s research and legal case ↗</a>
        </div>
      </section>

      <section class="quote-section chow-quote">
        <img src="/images/gallery/ford-bike.jpg" alt="Mayor Olivia Chow with her bicycle" loading="lazy" />
        <blockquote>
          <p>“We provided drawings, we provided studies, we provided everything they want so that we could put in the bike lanes and bring back a car lane.”</p>
          <footer>Mayor Olivia Chow, on the City’s proposed Bloor compromise</footer>
          <a href="https://www.cycleto.ca/what_happens_next_with_torontos_bike_lanes" target="_blank" rel="noreferrer">Read the CycleTO update ↗</a>
        </blockquote>
      </section>

      <section class="quote-section ford-quote">
        <img src="/images/gallery/doug-ford.png" alt="Premier Doug Ford wearing a bicycle helmet" loading="lazy" />
        <blockquote>
          <p>“I want to work collaboratively with the Mayor … hopefully we can find alternatives.”</p>
          <footer>Premier Doug Ford, June 2025</footer>
          <a href="https://www.cycleto.ca/what_happens_next_with_torontos_bike_lanes" target="_blank" rel="noreferrer">Read the context at CycleTO ↗</a>
        </blockquote>
        <div class="ford-context">
          <p>Ontario has bigger problems to solve: making housing affordable, strengthening health care and public transit, and protecting workers and businesses through U.S. tariff uncertainty. Instead, the province has chosen a cheap political fight, scapegoating people on bikes and overruling Toronto’s evidence-based street decisions.</p>
          <a class="inline-source" href="https://budget.ontario.ca/2025/" target="_blank" rel="noreferrer">Ontario’s 2025 Budget ↗</a>
        </div>
      </section>

      <section class="map-section" aria-labelledby="map-title">
        <div><h2 id="map-title">The routes at risk</h2><p>The province’s current RFP covers Bloor, Yonge, and University/Avenue Road</p><a class="inline-source" href="https://www.cycleto.ca/what_happens_next_with_torontos_bike_lanes" target="_blank" rel="noreferrer">CycleTO’s current corridor details ↗</a></div>
        <img class="route-map" src="/images/removal-map.webp" alt="Map showing the Toronto bike lane removal corridors" loading="lazy" />
      </section>

      <section class="news" aria-labelledby="news-title">
        <h2 id="news-title">Coverage worth reading</h2>
        <div class="news-links">{news.map((item) => <a href={item.url} target="_blank" rel="noreferrer"><span>{item.outlet}</span>{item.title}<b>↗</b></a>)}</div>
      </section>

      <section class="signup" id="sign-up" aria-labelledby="signup-title">
        <div>
          <h2 id="signup-title">Get a campaign sign</h2>
          <p>Sign up for a sticker, poster, or yard sign. We’ll email you with availability and pickup details.</p>
        </div>
        <div class="signup-form">
          <div class="ml-embedded" data-form="ytCH80"></div>
        </div>
      </section>

      <section class="gallery" aria-labelledby="gallery-title">
        <div class="gallery-heading"><h2 id="gallery-title">Signs, posters, and stickers</h2></div>
        <div class="gallery-grid">
          {gallery.map(([image, alt]) => <img src={`/images/gallery/${image}`} alt={alt} loading="lazy" />)}
        </div>
      </section>

      <section class="action" id="take-action" aria-labelledby="action-title">
        <div>
          <h2 id="action-title">Tell Ontario to stop removing Toronto’s bike lanes</h2>
          <p>Join the Defend Bloor campaign and tell your MPP that safer streets should not be dismantled.</p>
        </div>
        <div class="action-links">
          <a class="button" href="https://www.cycleto.ca/defendbloor" target="_blank" rel="noreferrer">Sign the petition</a>
          <a class="text-link" href="https://www.ola.org/en/office-assembly/whats-happening/how-contact-your-mpp" target="_blank" rel="noreferrer">Find your MPP <span aria-hidden="true">→</span></a>
          <p class="partner-note">The petition link opens CycleTO’s Defend Bloor campaign.</p>
        </div>
      </section>

    </main>

    <footer class="site-footer">
      <p>Save Lanes, Save Lives<br /><span>Volunteer-run, independent, and not for profit.</span></p>
      <p><a href="https://www.cycleto.ca/cycle_toronto_v_ontario" target="_blank" rel="noreferrer">Read CycleTO’s research and legal case ↗</a></p>
      <p><a href="https://www.cycleto.ca" target="_blank" rel="noreferrer">CycleTO ↗</a><a href="https://www.reddit.com/r/torontobiking/" target="_blank" rel="noreferrer">r/torontobiking ↗</a><a href="https://thebikinglawyer.ca" target="_blank" rel="noreferrer">The Biking Lawyer ↗</a></p>
    </footer>
  </body>
</html>

<style>
  :root { --green: #08a82a; --ink: #101410; --cream: #f6f4ee; --line: #dde1d9; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; color: var(--ink); background: var(--cream); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.5; }
  a { color: inherit; }
  .site-header { height: 86px; padding: 10px clamp(24px, 6vw, 94px); display: flex; align-items: center; justify-content: space-between; background: #fff; }
  .brand { display: inline-flex; align-items: center; }
  .brand-mark { width: 66px; height: 66px; border-radius:50%; object-fit:cover; }
  nav { display: flex; align-items: center; gap: 26px; font-weight: 700; }
  nav a, .text-link { text-decoration: none; }
  nav a:hover, .text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .nav-petition { padding: 11px 17px; border-radius: 4px; background: #ffe26b; text-decoration: none; }
  .nav-petition:hover { background: var(--green); color: #fff; text-decoration: none; }
  .hero { position: relative; min-height: min(540px, calc(100vh - 86px)); display: grid; place-items: center; overflow: hidden; isolation: isolate; }
  .hero-image, .hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-image { object-fit: cover; }
  .hero-shade { background: linear-gradient(90deg, rgba(0, 0, 0, .76) 0%, rgba(0, 0, 0, .42) 52%, rgba(0, 0, 0, .16) 100%); z-index: 1; }
  .hero-content { width: min(1100px, 88vw); position: relative; z-index: 2; color: #fff; }
  .eyebrow, .section-label { margin: 0 0 12px; font-size: .78rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { max-width: 680px; margin-bottom: 20px; font-size: clamp(3rem, 5.5vw, 4.9rem); line-height: .98; letter-spacing: -.055em; }
  .hero-copy { max-width: 550px; margin-bottom: 30px; font-size: clamp(1.05rem, 1.8vw, 1.25rem); line-height: 1.5; }
  .button { display: inline-block; padding: 15px 24px; border-radius: 4px; background: #ffe26b; color: #101410; font-weight: 850; text-decoration: none; }
  .button:hover { background: #fff; }
  .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:14px; }
  .hero-petition { padding:14px 18px; border:1px solid rgba(255,255,255,.82); border-radius:4px; color:#fff; font-weight:850; text-decoration:none; }
  .hero-petition:hover { background:#fff; color:var(--ink); }
  .intro, .reasons, .signup, .action { padding: clamp(48px, 6vw, 76px) clamp(24px, 7vw, 112px); }
  .intro { max-width: 930px; }
  h2 { max-width: 760px; margin-bottom: 16px; font-size: clamp(1.85rem, 3.05vw, 2.75rem); line-height: 1.08; letter-spacing: -.04em; }
  .intro > p:last-child { max-width: 740px; margin: 0; font-size: clamp(1.05rem, 1.6vw, 1.22rem); line-height: 1.62; }
  .common-ground { display:grid; grid-template-columns: minmax(0, .95fr) minmax(320px, .8fr); gap:clamp(36px, 7vw, 112px); padding:clamp(48px, 6vw, 76px) clamp(24px, 7vw, 112px); background:#fff; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .common-ground h2 { max-width:650px; }
  .common-copy { max-width:560px; padding-left:clamp(0px, 4vw, 56px); border-left:1px solid var(--line); }
  .common-copy > p { margin-bottom:18px; font-size:1.05rem; line-height:1.62; }
  .common-copy .common-callout { margin-top:26px; color:#416142; font-weight:800; }
  .inline-source { color: inherit; font-weight: 800; text-underline-offset: 4px; }
  .reasons { background: #fff; }
  .section-heading { margin-bottom: 32px; }
  .reason-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .reason-card { background: var(--cream); }
  .reason-card > img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .reason-copy { padding: 22px; }
  .reason-label { margin-bottom:9px; color:var(--green); font-size:1rem; font-weight:900; letter-spacing:-.025em; }
  h3 { margin-bottom: 10px; font-size: 1.35rem; letter-spacing: -.03em; }
  .reason-copy p:last-child { margin-bottom: 0; line-height: 1.48; }
  .source { display: inline-block; margin-top: 18px; color: #416142; font-size: .82rem; font-weight: 750; line-height: 1.35; }
  .supporting-facts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; padding:clamp(48px,6vw,76px) clamp(24px,7vw,112px); background:#fff; }
  .supporting-facts article { padding:30px; border-top:5px solid var(--green); background:var(--cream); }
  .proof-stat { margin-bottom:17px; color:var(--green); font-size:clamp(1.8rem,3vw,2.65rem); font-weight:900; line-height:1; letter-spacing:-.055em; }
  .supporting-facts h2 { margin-bottom:12px; font-size:1.5rem; }
  .supporting-facts article > p:not(.proof-stat) { max-width:580px; margin-bottom:0; line-height:1.55; }
  .data { padding:clamp(48px, 6vw, 76px) clamp(24px, 7vw, 112px); background:#e7f5e8; }
  .chart-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:16px; }
  .chart-card { padding:30px; background:#fff; border-top:5px solid var(--green); }
  .chart-label { margin-bottom:15px; font-size:.75rem; font-weight:900; letter-spacing:.1em; text-transform:uppercase; }
  .evidence-number { display:block; margin-bottom:8px; color:var(--green); font-size:clamp(2.6rem, 5vw, 4.1rem); line-height:.94; letter-spacing:-.065em; }
  .chart-card h3 { margin-bottom:10px; font-size:1.25rem; }
  .chart-card > p:not(.chart-label) { max-width:500px; margin:0; line-height:1.5; }
  .quote-section { display:grid; grid-template-columns:minmax(260px, .7fr) minmax(0, 1.3fr); min-height:340px; background:#fff; }
  .quote-section > img { width:100%; height:100%; min-height:300px; object-fit:cover; }
  .quote-section blockquote { margin:0; padding:clamp(32px,5vw,64px); align-self:center; }
  .quote-section blockquote p { max-width:670px; margin-bottom:20px; font-size:clamp(1.55rem,2.6vw,2.45rem); font-weight:850; line-height:1.1; letter-spacing:-.04em; }
  .quote-section blockquote footer { margin-bottom:16px; color:#416142; font-weight:800; }
  .quote-section blockquote a { font-weight:850; text-underline-offset:4px; }
  .ford-quote { background:#eef3ea; color:var(--ink); } .ford-quote blockquote footer { color:#416142; } .ford-quote > img { object-position:center 35%; } .ford-context { grid-column:2; max-width:760px; padding:0 clamp(32px,5vw,64px) clamp(36px,5vw,64px); } .ford-context p { max-width:720px; margin:0 0 17px; padding-top:24px; border-top:1px solid #c5d4c5; font-size:1.02rem; font-weight:600; line-height:1.58; }
  .map-section { display:grid; grid-template-columns:minmax(0,.85fr) minmax(320px,1.15fr); gap:clamp(36px,6vw,80px); align-items:center; padding:clamp(48px,6vw,76px) clamp(24px,7vw,112px); background:var(--cream); } .map-section > div > p:not(.section-label) { max-width:570px; margin-bottom:24px; font-size:1.05rem; line-height:1.55; } .route-map { width:100%; height:auto; }
  .news { padding:clamp(48px,6vw,76px) clamp(24px,7vw,112px); background:var(--green); color:#fff; } .news-links { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; } .news-links a { min-height:98px; display:grid; align-content:start; gap:7px; padding:18px; background:#fff; color:var(--ink); font-size:1rem; font-weight:850; text-decoration:none; } .news-links a:hover { background:#ffe26b; } .news-links span { color:#416142; font-size:.73rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; } .news-links b { color:var(--green); font-size:1.1rem; }
  .signup { display: grid; grid-template-columns: minmax(0, 480px) minmax(330px, 520px); justify-content:start; gap: clamp(40px, 6vw, 88px); align-items: start; background: var(--cream); }
  .signup > div > p:last-child { max-width: 580px; margin-bottom: 0; font-size: 1.1rem; line-height: 1.5; }
  .signup-form { padding: 28px; background: #fff; border-top: 7px solid var(--green); }
  .action { display: grid; grid-template-columns:minmax(0, 650px) minmax(240px, 320px); justify-content:start; gap:clamp(40px, 7vw, 110px); align-items: end; background: var(--green); color: #fff; }
  .action h2 { max-width: 700px; }
  .action > div:first-child > p:last-child { max-width: 630px; margin-bottom: 0; font-size: 1.1rem; line-height: 1.5; }
  .action-links { display: grid; gap: 18px; flex: 0 0 auto; }
  .text-link { font-weight: 800; }
  .partner-note { max-width: 250px; margin: 0; font-size: .78rem; line-height: 1.35; opacity: .8; }
  .gallery { padding:clamp(52px,7vw,86px) clamp(24px,7vw,112px); background:#fff; } .gallery-heading { margin-bottom:28px; } .gallery-grid { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:16px; } .gallery-grid img { display:block; width:100%; aspect-ratio:1; object-fit:cover; }
  .site-footer { display: grid; grid-template-columns:1.2fr 1fr 1fr; gap: 28px; padding: 32px clamp(24px, 7vw, 112px); background: #101410; color: #fff; font-size: .85rem; }
  .site-footer p { margin: 0; line-height:1.45; } .site-footer span { color:#b9c5b9; } .site-footer a { display:block; margin-bottom:8px; color:#fff; font-weight:750; }
  @media (max-width: 760px) { .site-header { height: 76px; } .brand-mark { width: 54px; height: 54px; } nav { gap: 14px; font-size: .82rem; } nav a:nth-child(-n+3) { display: none; } .nav-petition { padding: 9px 12px; } .hero { min-height:520px; } .hero-shade { background:rgba(0,0,0,.55); } .hero-actions { align-items:stretch; flex-direction:column; } .hero-actions > a { text-align:center; } .reason-grid, .signup, .chart-grid, .map-section, .quote-section, .news-links, .common-ground, .supporting-facts { grid-template-columns:1fr; } .common-copy { padding:0; border:0; } .quote-section > img { max-height:420px; } .ford-context { grid-column:auto; padding:0 clamp(32px,5vw,64px) clamp(36px,5vw,64px); } .action, .site-footer { display:block; } .action-links { margin-top:30px; justify-items:start; } .site-footer p + p { margin-top:16px; } .gallery-grid { grid-template-columns:repeat(2, minmax(0, 1fr)); } }
</style>
